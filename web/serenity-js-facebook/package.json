{
  "name": "serenity-js-the-internet",
  "version": "1.0.0",
  "description": "Automated BDD tests for The Internet Herokuapp using Serenity/JS, Cucumber and Playwright",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf target",
    "test": "failsafe clean test:execute test:report",
    "test:execute": "cucumber-js",
    "test:report": "serenity-bdd run --features ./features",
    "start": "mkdirp target/site/serenity && npx http-server -p 8080 target/site/serenity -s -o",
    "lint": "eslint --ext ts --config .eslintrc.js .",
    "lint:fix": "npm run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juanfranciscobumo/serenity-js-facebook.git"
  },
  "keywords": [
    "serenity-js",
    "bdd",
    "cucumber",
    "playwright",
    "testing",
    "the-internet",
    "herokuapp"
  ],
  "author": "Juan Francisco Builes",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@serenity-js/assertions": "^3.44.3",
    "@serenity-js/console-reporter": "^3.44.3",
    "@serenity-js/core": "^3.44.3",
    "@serenity-js/cucumber": "^3.44.3",
    "@serenity-js/playwright": "^3.44.3",
    "@serenity-js/serenity-bdd": "^3.44.3",
    "@serenity-js/web": "^3.44.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "is-ci": "^4.1.0",
    "mkdirp": "^3.0.1",
    "npm-failsafe": "^1.4.0",
    "playwright": "^1.62.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
