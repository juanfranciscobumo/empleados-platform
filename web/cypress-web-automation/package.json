{
  "name": "cypress-web-automation",
  "version": "1.0.0",
  "description": "Automatización web con Cypress y TypeScript",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --browser chrome --headless",
    "report:merge": "mochawesome-merge 'cypress/reports/*.json' > cypress/reports/merged-report.json",
    "report:html": "marge cypress/reports/merged-report.json --reportDir cypress/reports/html --overwrite",
    "report:generate": "npm run cypress:run && npm run report:merge && npm run report:html",
    "test:accessibility": "cypress run --spec 'cypress/e2e/tests/accessibility.cy.ts'",
    "test:dev": "cypress run --config-file cypress.config.ts --env configFile=dev",
    "test:staging": "cypress run --config-file cypress.config.ts --env configFile=staging",
    "test:prod": "cypress run --config-file cypress.config.ts --env configFile=prod",
    "lint": "eslint cypress/ --ext .ts",
    "lint:fix": "eslint cypress/ --ext .ts --fix",
    "format": "prettier --write 'cypress/**/*.ts'",
    "format:check": "prettier --check 'cypress/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "axe-core": "^4.13.0",
    "cypress": "^13.0.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0"
  }
}
