{
  "name": "empleados-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend tests for Empleados using Serenity-JS + Playwright",
  "scripts": {
    "test": "serenity-bdd run --config serenity.config.ts",
    "test:frontend": "serenity-bdd run --tags '@frontend'",
    "report": "serenity-bdd report"
  },
  "dependencies": {
    "@serenity-js/assertions": "^3.2.0",
    "@serenity-js/core": "^3.2.0",
    "@serenity-js/cucumber": "^3.2.0",
    "@serenity-js/playwright": "^3.2.0",
    "@serenity-js/serenity-bdd": "^3.2.0",
    "@serenity-js/web": "^3.2.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  },
  "keywords": ["serenity-js", "playwright", "frontend", "testing", "cucumber"],
  "author": "Juan Francisco Builes Montoya",
  "license": "MIT"
}
